{
  "name": "quickcaps-core",
  "version": "0.1.0",
  "description": "Rendered-DOM page distillation engine for quickcaps-cli — PageIR, design-token extraction, single-file/zip capture bundling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aagam-headout/quickcaps.git"
  },
  "homepage": "https://github.com/aagam-headout/quickcaps#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./distill": {
      "types": "./dist/distill.d.ts",
      "default": "./dist/distill.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "gpt-tokenizer": "^2.6.2",
    "zod": "^3.23.8"
  }
}
