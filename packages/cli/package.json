{
  "name": "quick-caps-cli",
  "version": "0.1.0",
  "description": "Distill any rendered web page into a few hundred tokens of numbered regions and actions, or capture it to disk — a CLI and MCP server for agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aagam-headout/quick-caps.git"
  },
  "homepage": "https://github.com/aagam-headout/quick-caps#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pc": "./bin/pc.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "quick-caps-core": "workspace:*",
    "esbuild": "^0.24.0",
    "fflate": "^0.8.2",
    "linkedom": "^0.18.5",
    "playwright": "^1.48.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
