{
  "name": "quick-caps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run --exclude '**/collector-bundle.test.ts' --exclude '**/build-artifacts.test.ts'",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.base.json && tsc --noEmit -p apps/extension/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm --filter @quick-caps/extension build",
    "build:packages": "pnpm --filter quick-caps-core build && pnpm --filter quick-caps-cli build",
    "ship": "node scripts/ship.mjs",
    "e2e": "pnpm --filter @quick-caps/extension build:e2e && pnpm --filter @quick-caps/extension e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.9.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
