{
  "name": "@quick-caps/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run theme && vite build && vite build --config vite.collector.config.ts && vite build --config vite.picker.config.ts",
    "theme": "tsx scripts/generate-theme-css.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "e2e": "playwright test",
    "build:e2e": "PC_E2E=1 pnpm run theme && PC_E2E=1 vite build && PC_E2E=1 vite build --config vite.collector.config.ts && PC_E2E=1 vite build --config vite.picker.config.ts"
  },
  "dependencies": {
    "quick-caps-core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "single-file-core": "^1.5.84"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/chrome": "^0.0.280",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "fflate": "^0.8.2",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "vite": "^5.4.10"
  }
}
