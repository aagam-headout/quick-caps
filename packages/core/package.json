{
  "name": "quick-caps-core",
  "version": "0.1.0",
  "description": "Rendered-DOM page distillation engine for quick-caps-cli \u2014 PageIR, design-token extraction, single-file/zip capture bundling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aagam-headout/quick-caps.git"
  },
  "homepage": "https://github.com/aagam-headout/quick-caps/tree/main/packages/core#readme",
  "keywords": [
    "dom",
    "page-capture",
    "design-tokens",
    "distillation",
    "agent",
    "html-archive"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./distill": {
      "types": "./dist/distill.d.ts",
      "default": "./dist/distill.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./collect": {
      "types": "./dist/collect.d.ts",
      "default": "./dist/collect.js"
    },
    "./extract": {
      "types": "./dist/extract/index.d.ts",
      "default": "./dist/extract/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "gpt-tokenizer": "^4.0.0",
    "zod": "^4.5.4"
  }
}
